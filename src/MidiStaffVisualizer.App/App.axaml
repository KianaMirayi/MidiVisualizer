<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MidiStaffVisualizer.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- 深色 + 暖色调，和参考视频里的观感一致 -->
        <SolidColorBrush x:Key="AppBackground" Color="#0B0C0F" />
        <SolidColorBrush x:Key="PanelBackground" Color="#14161A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#2A2E36" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFB454" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA2AE" />
        <SolidColorBrush x:Key="TextDim" Color="#6C7480" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#5FD08A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E8B84B" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
