<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MidiStaffVisualizer.App.ViewModels"
        xmlns:controls="using:MidiStaffVisualizer.App.Controls"
        xmlns:diag="using:MidiStaffVisualizer.Core.Diagnostics"
        x:Class="MidiStaffVisualizer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MIDI 实时五线谱 · 直通 Kontakt 7"
        Width="1240" Height="780"
        MinWidth="1000" MinHeight="640"
        Background="{StaticResource AppBackground}">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,390">

        <!-- 左侧：五线谱 + 和弦框 + 屏幕键盘 -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto,190" Margin="16,16,8,16">
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">
                <controls:StaffControl Columns="{Binding StaffColumns}"
                                       PreferFlats="{Binding PreferFlats}"
                                       ShowNoteNames="{Binding ShowNoteNames}" />
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    MinHeight="96"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="{Binding ChordRoot}"
                               FontSize="46"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChordQuality}"
                               FontSize="26"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChordBass}"
                               FontSize="26"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8">
                <controls:PianoKeyboardControl Notes="{Binding SoundingNotes}"
                                               ShowNoteNames="{Binding ShowNoteNames}"
                                               PreferFlats="{Binding PreferFlats}" />
            </Border>
        </Grid>

        <!-- 右侧：控制面板 -->
        <ScrollViewer Grid.Column="1" Padding="8,16,16,16">
            <StackPanel Spacing="12">

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="① MIDI 输入" Classes="sectionTitle" />
                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding ToggleButtonText}"
                                    Command="{Binding ToggleConnectionCommand}" />
                            <Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding StatusDetail}" Classes="hint" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="② MIDI 直通（→ Kontakt 7）" Classes="sectionTitle" />
                        <CheckBox Content="开启直通" IsChecked="{Binding ThruEnabled, Mode=TwoWay}" />
                        <TextBlock Text="输出端口（可多选，loopMIDI 建的端口就在这里）" Classes="label" />
                        <ItemsControl ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MidiOutputPortViewModel">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ThruStatusText}" Classes="hint" />
                        <Grid ColumnDefinitions="*,8,*">
                            <ComboBox Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding TransposeOptions}"
                                      SelectedIndex="{Binding TransposeIndex, Mode=TwoWay}" />
                            <ComboBox Grid.Column="2"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ChannelOptions}"
                                      SelectedIndex="{Binding ChannelFilterIndex, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding ForwardedText}"
                                       Classes="hint"
                                       VerticalAlignment="Center" />
                            <Button Content="全部音符复位" Command="{Binding PanicCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="③ 显示选项" Classes="sectionTitle" />
                        <CheckBox Content="降号优先（写成 D♭ 而不是 C♯）"
                                  IsChecked="{Binding PreferFlats, Mode=TwoWay}" />
                        <CheckBox Content="显示音名"
                                  IsChecked="{Binding ShowNoteNames, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="④ 最近弹奏" Classes="sectionTitle" />
                            <Button Grid.Column="1"
                                    Content="清空"
                                    FontSize="12"
                                    Padding="8,2"
                                    Command="{Binding ClearRecentNotesCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding RecentNotes}" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NoteLogItem">
                                    <TextBlock Text="{Binding Display}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⑤ 让对方听到 Kontakt 7（音频路由）" Classes="sectionTitle" />
                        <TextBlock Text="{Binding AudioHint}" Classes="hint" />
                        <TextBlock Text="{Binding RoutingGuide}" Classes="hint" />
                        <Button Content="打开 Windows 声音设置" Command="{Binding OpenSoundSettingsCommand}" />
                        <Expander Header="检测到的音频设备" FontSize="12">
                            <ListBox ItemsSource="{Binding AudioEndpoints}" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="diag:AudioEndpointInfo">
                                        <TextBlock Text="{Binding Display}" FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
